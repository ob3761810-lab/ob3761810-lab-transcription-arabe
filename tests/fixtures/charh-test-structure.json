      "blocks": [
        {
          "type": "titre",
          "text": "بسم الله الرحمن الرحيم"
        },
        {
          "type": "paragraphe",
          "text": "أي أنظم الأشياء الآتية متبركاً بإسم الله الرحمن الرحيم .\nوابتدأت بالبسملة والحمدلة كما يأتي اقتداء بالكتاب العزيز وعملاً بالأحاديث الواردة ."
        },
        {
          "type": "vers",
          "sadr": "يقول راجي رحمة الغفور",
          "ajuz": "دوماً سليمان هو الجمزوري"
        },
        {
          "type": "vers",
          "sadr": "الحمد لله مصلياً على",
          "ajuz": "محمد وآله ومن تلا"
        },
        {
          "type": "paragraphe",
          "text": "أي يقول مؤمل إحسان ربه الغفور أي كثير المغفرة أي الستر على الخطايا فلم يؤاخذ عليها دائماً."
        },
        {
          "type": "vers",
          "sadr": "وبعد هذا النظم للمريد",
          "ajuz": "في النون والتنوين والمدود"
        },
        {
          "type": "vers",
          "sadr": "سميته بتحفة الأطفال",
          "ajuz": "عن شيخنا الميهي ذي الكمال"
        },
        {
          "type": "paragraphe",
          "text": "أي وبعد ما تقدم من حمد الله الأتم فهذا النظم أي المنظوم."
        }
      ]
    }
  ]
}